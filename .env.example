# Persistent storage for model caches, calibration artifacts, and outputs.
RUN_BASE=/path/to/persistent-storage/qwen38-27b-awq

# The FP8 baseline a paired eval compares against. Not derivable from RUN_BASE,
# and eval/slurm/paired-suite-eval.sbatch refuses to start without both.
PAIRED_BASELINE_REPO=/path/to/persistent-storage/qwen38-27b-awq/huggingface/hub/models--Qwen--Qwen3.8-27B-FP8
PAIRED_BASELINE_REVISION=017b9c7af6b5689d5dd426a76e0bc077eb5ca20a

# Optional overrides. Defaults are a digest-pinned Qwen3.8 vLLM image and a SIF
# under $RUN_BASE/containers, as defined by common/scripts/load_env.sh.
# EVAL_VLLM_BASE_IMAGE=docker://vllm/vllm-openai@sha256:d392f621bb3e372ecc09f0b0cb88099afe9fa05d37a0450de45eeb8c12b6787e
# EVAL_APPTAINER_IMAGE=/path/to/persistent-storage/qwen38-27b-awq/containers/qwen38-eval-vllm.sif
